<script>
(function(){
  var toggle = document.getElementById('navToggle');
  var links = document.getElementById('navLinks');
  toggle.addEventListener('click', function(){
    links.classList.toggle('open');
  });
  links.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ links.classList.remove('open'); });
  });

  var sections = document.querySelectorAll('section[id]');
  var navAnchors = document.querySelectorAll('.nav-links a');
  function onScroll(){
    var pos = window.scrollY + 120;
    sections.forEach(function(sec){
      var top = sec.offsetTop, bottom = top + sec.offsetHeight;
      var id = sec.getAttribute('id');
      var link = document.querySelector('.nav-links a[href="#'+id+'"]');
      if(!link) return;
      if(pos >= top && pos < bottom){
        navAnchors.forEach(function(a){a.classList.remove('active');});
        link.classList.add('active');
      }
    });
  }
  window.addEventListener('scroll', onScroll, {passive:true});

  var revealEls = document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, {threshold:0.15});
    revealEls.forEach(function(el){ io.observe(el); });
  } else {
    revealEls.forEach(function(el){ el.classList.add('in'); });
  }

  var tabBtns = document.querySelectorAll('.tab-btn');
  tabBtns.forEach(function(btn){
    btn.addEventListener('click', function(){
      tabBtns.forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      document.querySelectorAll('.tab-panel').forEach(function(p){p.classList.remove('active');});
      document.getElementById(btn.getAttribute('data-tab')).classList.add('active');
    });
  });
  document.querySelectorAll('.t-item').forEach(function(item){
    item.addEventListener('click', function(){
      item.classList.toggle('open');
    });
  });

  var langRows = document.querySelectorAll('.lang-row');
  if('IntersectionObserver' in window){
    var io2 = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          var row = entry.target;
          var level = row.getAttribute('data-level');
          row.querySelector('.bar-fill').style.width = level + '%';
          io2.unobserve(row);
        }
      });
    }, {threshold:0.4});
    langRows.forEach(function(row){ io2.observe(row); });
  } else {
    langRows.forEach(function(row){
      row.querySelector('.bar-fill').style.width = row.getAttribute('data-level') + '%';
    });
  }

  var filterBtns = document.querySelectorAll('.filter-btn');
  var projectCards = document.querySelectorAll('.project-card');
  filterBtns.forEach(function(btn){
    btn.addEventListener('click', function(){
      filterBtns.forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      var filter = btn.getAttribute('data-filter');
      projectCards.forEach(function(card){
        if(filter === 'all' || card.getAttribute('data-cat') === filter){
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  var CV_PDF_B64 = "";
  function base64ToBlob(b64, mime){
    var byteChars = atob(b64);
    var byteNumbers = new Array(byteChars.length);
    for (var i = 0; i < byteChars.length; i++){
      byteNumbers[i] = byteChars.charCodeAt(i);
    }
    var byteArray = new Uint8Array(byteNumbers);
    return new Blob([byteArray], {type: mime});
  }
  async function downloadCV(btn){
    var original = btn.textContent;
    var blob = base64ToBlob(CV_PDF_B64, 'application/pdf');
    try{
      var downloads = (window.claude && window.claude.use) ? await window.claude.use("downloads") : null;
      if(downloads){
        var result = await downloads.save({filename: 'Dionisio_Daniel_Vilanculo_CV.pdf', data: blob});
        if(result && (result.status === 'saved' || result.status === 'delivered')){
          btn.textContent = 'baixado!';
          setTimeout(function(){ btn.textContent = original; }, 1800);
        }
        return;
      }
    }catch(err){
      if(err && err.code === 'declined'){
        return;
      }
    }
    try{
      var url = URL.createObjectURL(blob);
      window.open(url, '_blank');
      setTimeout(function(){ URL.revokeObjectURL(url); }, 60000);
    }catch(err){
      btn.textContent = 'erro';
      setTimeout(function(){ btn.textContent = original; }, 1800);
    }
  }
  ['cvDownloadHero','cvDownloadCard'].forEach(function(id){
    var btn = document.getElementById(id);
    if(btn){
      btn.addEventListener('click', function(){ downloadCV(btn); });
    }
  });

  document.querySelectorAll('.copy-btn').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      var text = btn.getAttribute('data-copy');
      var original = btn.textContent;
      try{
        navigator.clipboard.writeText(text).then(function(){
          btn.textContent = 'copiado!';
          setTimeout(function(){ btn.textContent = original; }, 1500);
        });
      }catch(err){
        btn.textContent = 'erro';
        setTimeout(function(){ btn.textContent = original; }, 1500);
      }
    });
  });
})();
</script>

